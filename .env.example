# Docker Compose reads .env from the repository root. Same variables as
# deploy/seatlab.env.example; keep both in sync.
# Copy to /etc/seatlab.env, chmod 600, and edit.
# systemd unit already reads this path (EnvironmentFile=-/etc/seatlab.env).

# --- storage -----------------------------------------------------------------
# Single node (SQLite):
SEATLAB_DB=/var/lib/seatlab/seatlab.db
# Multi-instance (PostgreSQL) instead:
# SEATLAB_DB=postgresql://seatlab:CHANGE_ME@db.example.edu:5432/seatlab

# --- shared keys (optional) --------------------------------------------------
# Simulation endpoints, only needed if you expose them publicly:
SEATLAB_API_KEY=change-me-to-a-long-random-string
# Break-glass key for /admin when SSO is down. Leave empty to require SSO only.
SEATLAB_ADMIN_KEY=
# Kiosk/shared code for student writes. Leave EMPTY when using SSO; a browser
# cannot keep a shared secret. Set it only for wall-mounted kiosks on a VLAN.
SEATLAB_APP_KEY=
SEATLAB_CORS_ORIGINS=https://lib.example.edu.cn

# --- campus single sign-on ---------------------------------------------------
# header = trusted X-Student-ID only (LAN / authenticating reverse proxy).
# cas    = Apereo CAS 2.0/3.0.    oauth = OAuth2 / OIDC.
SEATLAB_AUTH_MODE=cas
SEATLAB_PUBLIC_URL=https://seat.example.edu
SEATLAB_SESSION_SECRET=generate-with-python-secrets-token_urlsafe-48
SEATLAB_SESSION_TTL_H=12
SEATLAB_COOKIE_SECURE=1
SEATLAB_TRUST_HEADER=0

# Librarians by campus id (comma separated), independent of IdP roles:
SEATLAB_ADMIN_IDS=20241009,20241010
# Or map IdP role/group names:
SEATLAB_ADMIN_ROLES=admin,librarian,staff
SEATLAB_ADMIN_SSO=1

# CAS:
SEATLAB_CAS_BASE=https://cas.example.edu/cas
# Must match the service registered at the CAS server:
SEATLAB_CAS_SERVICE=https://seat.example.edu/auth/callback
# SEATLAB_CAS_VALIDATE=https://cas.example.edu/cas/p3/serviceValidate
# SEATLAB_CAS_ID_ATTR=user
# SEATLAB_CAS_NAME_ATTR=displayName

# OAuth2 / OIDC (Keycloak, Authing, campus gateway):
# SEATLAB_OAUTH_AUTHORIZE=https://sso.example.edu/realms/campus/protocol/openid-connect/auth
# SEATLAB_OAUTH_TOKEN=https://sso.example.edu/realms/campus/protocol/openid-connect/token
# SEATLAB_OAUTH_USERINFO=https://sso.example.edu/realms/campus/protocol/openid-connect/userinfo
# SEATLAB_OAUTH_CLIENT_ID=seatlab
# SEATLAB_OAUTH_CLIENT_SECRET=CHANGE_ME
# SEATLAB_OAUTH_SCOPE=openid profile email
# SEATLAB_OAUTH_ID_FIELD=preferred_username
